  "version": "0.2.0",
  "configurations": [
    {
      "name": "ESP-IDF Debug",
      "type": "node",
      "request": "launch",
      "program": "${command:espIdf.getProjectAppElf}",
      "cwd": "${workspaceFolder}"
    },
    {
        "type": "cmake",
        "request": "launch",
        "name": "CMake: Configure project",
        "cmakeDebugType": "configure",
        "clean": false,
        "configureAll": false
    },
    {
      "name": "Python Debugger: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal"
    },
    {
      "name": "Python Debugger: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal"
    }
  ]
}
